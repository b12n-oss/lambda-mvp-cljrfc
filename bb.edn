{:tasks
 {:requires ([babashka.process :as p])

  info {:doc "task cheat-sheet"
        :task (do (println "lambda-mvp-cljrfc -- AWS Lambda demo handler in ClojureScript, compiled by Clojurific")
                  (println "")
                  (println "  bb verify      the complete offline gate: test + build + smoke (what CI runs)")
                  (println "  bb build       Clojurific + vite build -> dist/index.mjs -> dist/lambda.zip")
                  (println "  bb smoke       local smoke: invoke the bundled handler with a canned event (no AWS)")
                  (println "  bb test        run script/bench.clj's unit tests")
                  (println "  bb demo        build + deploy + invoke in one go, prerequisites checked first")
                  (println "  bb deploy      idempotent: IAM role + Lambda function, create or update")
                  (println "  bb invoke      single ad-hoc invoke, prints response + REPORT line")
                  (println "  bb bench       cold/warm boot-time comparison across memory tiers")
                  (println "  bb teardown    delete the function + role")
                  (println "  bb clean       remove build artifacts")
                  (println "")
                  (println "No task hardcodes an AWS profile, account, or region -- see README.md"))}

  test {:doc "run script/bench.clj's unit tests"
        :task (p/shell "bb" "test/bench_test.clj")}

  clean {:doc "remove build artifacts"
         :task (p/shell "rm" "-rf" "dist" "target" ".cljf" ".cpcache")}

  build {:doc "Clojurific + vite build -> dist/index.mjs -> dist/lambda.zip"
         :task (do
                 (when-not (.exists (java.io.File. "node_modules/clojurific"))
                   (p/shell "npm" "ci"))
                 ;; vite build runs the Clojurific compiler (its plugin), then
                 ;; bundles the :js-entries module into one self-contained ES
                 ;; module: no node_modules goes in the zip.
                 (let [{:keys [exit]} (p/shell {:continue true} "npx" "vite" "build")]
                   (when-not (zero? exit)
                     (println "build: vite build failed")
                     (System/exit exit)))
                 (let [{:keys [exit]} (p/shell {:continue true :dir "dist"} "zip" "-q" "lambda.zip" "index.mjs")]
                   (when (zero? exit) (p/shell "ls" "-l" "dist"))
                   (System/exit exit)))}

  deploy {:doc "idempotent: IAM role + Lambda function, create or update"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "deploy")}

  invoke {:doc "single ad-hoc invoke, prints response + REPORT line"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "invoke")}

  teardown {:doc "delete the function + role"
            :task (p/shell "bb" "script/aws_lifecycle.clj" "teardown")}

  bench {:doc "cold/warm boot-time comparison across memory tiers"
         :task (p/shell "bb" "script/bench_run.clj")}

  demo {:doc "build + deploy + invoke in one go, checking every prerequisite before starting"
        :task (p/shell "bb" "script/demo.clj")}

  smoke {:doc "local smoke: invoke the bundled handler with a canned event (run `bb build` first)"
         :task (if-not (.exists (java.io.File. "dist/index.mjs"))
                 (do (println "smoke: dist/index.mjs not found -- run `bb build` first")
                     (System/exit 1))
                 (let [{:keys [exit]} (p/shell {:continue true} "node" "--input-type=module" "-e"
                                               (str "const m = await import('./dist/index.mjs');"
                                                    "const ctx = {awsRequestId: 'smoke-test-req'};"
                                                    "const r1 = await m.handler({name: 'jolt', n: 1}, ctx);"
                                                    "const r2 = await m.handler({name: 'jank', n: 2}, ctx);"
                                                    "console.log('invocation 1:', JSON.stringify(r1));"
                                                    "console.log('invocation 2:', JSON.stringify(r2));"
                                                    "if (r1.warm_invocation !== 1 || r2.warm_invocation !== 2) {"
                                                    "  console.error('smoke: warm_invocation did not increment as expected');"
                                                    "  process.exit(1);"
                                                    "}"
                                                    "if (r1.request_id !== 'smoke-test-req') {"
                                                    "  console.error('smoke: request_id did not come through');"
                                                    "  process.exit(1);"
                                                    "}"
                                                    "if (r1.event.name !== 'jolt') {"
                                                    "  console.error('smoke: event was not echoed back');"
                                                    "  process.exit(1);"
                                                    "}"
                                                    "console.log('smoke: PASS');"))]
                   (System/exit exit)))}

  verify {:doc "the complete offline gate: test + build + smoke (what CI runs)"
          :task (do
                  (p/shell "bb" "test")
                  (p/shell "bb" "build")
                  (p/shell "bb" "smoke"))}}}
